@page
@model CRMConnect.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customer Monitoring";
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-slic">@Model.Message</div> }

<div class="slic-card">
    <div class="slic-card-header">All Customer Records</div>
    <div class="slic-card-body p-0">
        <table class="table slic-table mb-0">
            <thead><tr><th>ID</th><th>Name</th><th>Company</th><th>Email</th><th>Phone</th><th>Status</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>@c.Id</td><td><strong>@c.Name</strong></td><td>@c.Company</td>
                        <td>@c.Email</td><td>@c.Phone</td><td>@c.Status</td>
                        <td>@c.Created?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <form method="post" asp-page-handler="Delete"><input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this customer record?')">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
