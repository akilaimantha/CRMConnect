@page
@model CRMConnect.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-2">
    <div>
        <h2 class="slic-page-title">Admin Dashboard</h2>
        <p class="slic-page-subtitle mb-0">Overview of customers, sales activities, and pending tasks</p>
    </div>
    <a href="/Customers" class="btn-slic-gold">Add Customer <span class="btn-arrow-icon">→</span></a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="slic-stat-card">
            <div class="slic-stat-icon">👥</div>
            <div class="slic-stat-number">@Model.TotalCustomers</div>
            <div class="slic-stat-label">Total Customers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="slic-stat-card gold">
            <div class="slic-stat-icon">✅</div>
            <div class="slic-stat-number">@Model.PendingTasks</div>
            <div class="slic-stat-label">Pending Tasks</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="slic-stat-card dark">
            <div class="slic-stat-icon">💰</div>
            <div class="slic-stat-number">@Model.TotalSales</div>
            <div class="slic-stat-label">Sales Activities</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="slic-card">
            <div class="slic-card-header">
                Recent Tasks (Due Soon)
            </div>
            <div class="slic-card-body p-0">
                @if (Model.RecentTasks.Any())
                {
                    <div class="table-responsive">
                        <table class="table slic-table mb-0">
                            <thead>
                                <tr>
                                    <th>Task</th>
                                    <th>Assigned To</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in Model.RecentTasks)
                                {
                                    <tr>
                                        <td>@task.TaskDescription</td>
                                        <td>@task.AssignedTo</td>
                                        <td>@task.DueDate?.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (task.Status == "Pending")
                                            {
                                                <span class="badge-slic-pending">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge-slic-done">Completed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted p-4 mb-0">No tasks found. Connect Oracle and run the schema script.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="slic-card mb-3">
            <div class="slic-card-header gold">Quick Actions</div>
            <div class="slic-card-body d-grid gap-2">
                <a href="/Customers" class="btn btn-slic-teal text-white">Manage Customers</a>
                <a href="/Sales" class="btn btn-outline-secondary">Log Sales Activity</a>
                <a href="/Tasks" class="btn btn-outline-secondary">Create Task</a>
                <a href="/Communication" class="btn btn-outline-secondary">Communication Log</a>
            </div>
        </div>
        <div class="slic-card">
            <div class="slic-card-header">System</div>
            <div class="slic-card-body">
                <p class="small text-muted mb-2">Task notifications check every 5 minutes for items due within 3 days.</p>
                <a href="/Admin/Users" class="btn btn-sm btn-slic-teal text-white">User Management</a>
                <a href="/Admin/Settings" class="btn btn-sm btn-outline-secondary ms-1">Settings</a>
            </div>
        </div>
    </div>
</div>
