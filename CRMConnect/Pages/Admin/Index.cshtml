@page
@model CRMConnect.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="slic-stat-card"><div class="slic-stat-number">@Model.TotalUsers</div><div class="slic-stat-label">Total Users</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card gold"><div class="slic-stat-number">@Model.TotalCustomers</div><div class="slic-stat-label">Total Customers</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card"><div class="slic-stat-number">@Model.TotalSales</div><div class="slic-stat-label">Sales Activities</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card dark"><div class="slic-stat-number">@Model.ActiveUsers</div><div class="slic-stat-label">Active Users</div></div></div>
</div>

<div class="row g-4">
    <div class="col-md-4"><div class="slic-card"><div class="slic-card-body"><h5 style="color:var(--slic-teal)">User Management</h5><p class="small text-muted">Add, edit, delete sales representatives and reset passwords.</p><a href="/Admin/Users" class="btn btn-slic-teal text-white btn-sm">Manage Users</a></div></div></div>
    <div class="col-md-4"><div class="slic-card"><div class="slic-card-body"><h5 style="color:var(--slic-teal)">Customer Monitoring</h5><p class="small text-muted">View all customer records and remove invalid entries.</p><a href="/Admin/Customers" class="btn btn-slic-teal text-white btn-sm">View Customers</a></div></div></div>
    <div class="col-md-4"><div class="slic-card"><div class="slic-card-body"><h5 style="color:var(--slic-teal)">Reports</h5><p class="small text-muted">Sales reports, user activity, and customer statistics.</p><a href="/Admin/Reports" class="btn btn-slic-teal text-white btn-sm">View Reports</a></div></div></div>
</div>
