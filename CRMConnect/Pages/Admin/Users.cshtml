@page
@model CRMConnect.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "User Management";
}

<h2 class="slic-page-title">User Management</h2>
<p class="slic-page-subtitle">Manage admin and sales user accounts (AppUsers table)</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-slic alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="slic-card">
            <div class="slic-card-header">Add New User</div>
            <div class="slic-card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Username *</label>
                        <input type="text" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password *</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select">
                            <option value="Admin">Admin</option>
                            <option value="User">Sales User</option>
                        </select>
                    </div>
                    <button type="submit" class="btn-slic-gold w-100 justify-content-center">Create User <span class="btn-arrow-icon">→</span></button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="slic-card">
            <div class="slic-card-header">Application Users</div>
            <div class="slic-card-body p-0">
                <div class="table-responsive">
                    <table class="table slic-table mb-0">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Role</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td><strong>@user.Username</strong></td>
                                    <td><span class="badge bg-secondary">@user.Role</span></td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete" class="d-inline">
                                            <input type="hidden" name="id" value="@user.UserID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this user?')">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
