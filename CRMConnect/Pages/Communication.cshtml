@page
@model CRMConnect.Pages.CommunicationModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Communication Log";
}

<h2 class="slic-page-title">Communication Log</h2>
<p class="slic-page-subtitle">Record and track all customer communications</p>

<div class="slic-card mb-4">
    <div class="slic-card-header">Log New Communication</div>
    <div class="slic-card-body">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-slic alert-dismissible fade show">@Model.Message<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Customer *</label>
                    <select name="CustomerId" class="form-select" required>
                        <option value="">-- Select --</option>
                        @foreach (var c in Model.Customers) { <option value="@c.CustomerID">@c.Name</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Type</label>
                    <select name="CommType" class="form-select">
                        <option>Phone Call</option>
                        <option>Email</option>
                        <option>Meeting</option>
                        <option>Note</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" id="commNotes" class="form-control" rows="4"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn-slic-gold">Save Communication <span class="btn-arrow-icon">→</span></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="slic-card mb-4">
    <div class="slic-card-header gold">Quick Templates</div>
    <div class="slic-card-body">
        <div class="row g-2">
            <div class="col-md-3"><button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="insertNote('Follow-up call completed. Customer will review proposal.')">Follow-up Call</button></div>
            <div class="col-md-3"><button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="insertNote('Sent brochure and pricing via email.')">Send Info</button></div>
            <div class="col-md-3"><button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="insertNote('Meeting scheduled for product demo.')">Schedule Meeting</button></div>
            <div class="col-md-3"><button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="insertNote('Customer confirmed interest in premium plan.')">Lead Update</button></div>
        </div>
    </div>
</div>

<div class="slic-card mb-3">
    <div class="slic-card-body py-3">
        <div class="row g-2">
            <div class="col-md-5"><input type="text" id="searchCustomer" class="form-control form-control-sm" placeholder="Search customer..." value="@Model.SearchTerm" /></div>
            <div class="col-md-4">
                <select id="filterType" class="form-select form-select-sm">
                    <option value="All">All Types</option>
                    <option value="Phone Call">Phone</option>
                    <option value="Email">Email</option>
                    <option value="Meeting">Meeting</option>
                </select>
            </div>
            <div class="col-md-3"><button class="btn btn-sm btn-slic-teal text-white w-100" onclick="applyFilters()">Search</button></div>
        </div>
    </div>
</div>

<div class="slic-card">
    <div class="slic-card-header">Communication Timeline</div>
    <div class="slic-card-body">
        @if (Model.Communications.Any())
        {
            @foreach (var comm in Model.Communications)
            {
                <div class="activity-item">
                    <div class="d-flex justify-content-between flex-wrap">
                        <div>
                            <h5 style="color: var(--slic-teal);">@comm.CustomerName</h5>
                            <span class="comm-type comm-type-@comm.CommTypeClass">@comm.CommTypeIcon @comm.CommType</span>
                            <p class="mt-2 mb-0">@comm.Notes</p>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">@comm.CommunicationDate.ToString("dd MMM yyyy · h:mm tt")</div>
                            <form method="post" asp-page-handler="Delete" class="mt-2">
                                <input type="hidden" name="id" value="@comm.LogID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else { <p class="text-muted text-center">No records found.</p> }
    </div>
</div>

@section Scripts {
<script>
    function insertNote(n) { document.getElementById('commNotes').value += n + '\n\n'; }
    function applyFilters() {
        window.location.href = '/Communication?search=' + encodeURIComponent(document.getElementById('searchCustomer').value) + '&type=' + document.getElementById('filterType').value;
    }
</script>
}
