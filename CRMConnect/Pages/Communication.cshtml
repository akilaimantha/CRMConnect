@page
@model CRMConnect.Pages.CommunicationModel
@{
    ViewData["Title"] = "Communication Log";
}

<style>
    .comm-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
    }
    .form-container {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .btn-comm {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        transition: transform 0.3s;
    }
    .btn-comm:hover {
        transform: scale(1.05);
        color: white;
    }
    .comm-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 15px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        border-left: 4px solid #f5576c;
        transition: all 0.3s;
    }
    .comm-card:hover {
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        transform: translateX(5px);
    }
    .comm-type {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }
    .comm-type-phone { background: #28a745; color: white; }
    .comm-type-email { background: #17a2b8; color: white; }
    .comm-type-meeting { background: #ffc107; color: #333; }
    .comm-type-note { background: #6c757d; color: white; }
    .comm-date {
        color: #f5576c;
        font-size: 12px;
        font-weight: bold;
    }
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    .quick-note {
        background: #f8f9fa;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: background 0.3s;
        text-align: center;
    }
    .quick-note:hover {
        background: #e9ecef;
    }
    .search-box {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
</style>

<div class="comm-header">
    <div class="row">
        <div class="col-md-8">
            <h1>💬 Communication Log</h1>
            <p class="mb-0">Track all customer interactions - calls, emails, meetings, and notes</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="comm-type comm-type-phone me-2">📞 Calls</span>
            <span class="comm-type comm-type-email me-2">✉️ Emails</span>
            <span class="comm-type comm-type-meeting">🤝 Meetings</span>
        </div>
    </div>
</div>

<!-- Add Communication Form -->
<div class="form-container">
    <h4 class="mb-3">💬 Log New Communication</h4>
    
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <form method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Select Customer *</label>
                <select name="CustomerId" class="form-select" required>
                    <option value="">-- Select Customer --</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.CustomerID">@customer.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Communication Type *</label>
                <select name="CommType" class="form-select">
                    <option value="Phone Call">📞 Phone Call</option>
                    <option value="Email">✉️ Email</option>
                    <option value="Meeting">🤝 Meeting</option>
                    <option value="Note">📝 General Note</option>
                </select>
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label">Communication Notes</label>
                <textarea name="Notes" class="form-control" rows="4" id="commNotes" placeholder="Record details of the conversation, important points, action items..."></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn-comm">💾 Save Communication</button>
            </div>
        </div>
    </form>
</div>

<!-- Quick Note Templates -->
<div class="form-container">
    <h4 class="mb-3">⚡ Quick Note Templates</h4>
    <div class="row">
        <div class="col-md-3">
            <div class="quick-note" onclick="insertNote('Called customer to follow up on proposal. Customer said they will review and get back by next week.')">
                📞 Follow-up Call
            </div>
        </div>
        <div class="col-md-3">
            <div class="quick-note" onclick="insertNote('Sent product brochure and pricing details via email. Customer requested additional information about features.')">
                ✉️ Send Information
            </div>
        </div>
        <div class="col-md-3">
            <div class="quick-note" onclick="insertNote('Scheduled product demo for next Tuesday at 2 PM. Will send calendar invitation.')">
                🤝 Schedule Meeting
            </div>
        </div>
        <div class="col-md-3">
            <div class="quick-note" onclick="insertNote('Customer confirmed interest in premium plan. Need to prepare contract.')">
                📝 Lead Update
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="search-box">
    <div class="row">
        <div class="col-md-4">
            <label>Search by Customer</label>
            <input type="text" id="searchCustomer" class="form-control" placeholder="Type customer name..." value="@Model.SearchTerm" />
        </div>
        <div class="col-md-3">
            <label>Filter by Type</label>
            <select id="filterType" class="form-select">
                <option value="All">All Types</option>
                <option value="Phone Call">📞 Phone Calls</option>
                <option value="Email">✉️ Emails</option>
                <option value="Meeting">🤝 Meetings</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-primary w-100" onclick="applyFilters()">Search</button>
        </div>
        <div class="col-md-2">
            <label>&nbsp;</label>
            <button class="btn btn-secondary w-100" onclick="resetFilters()">Reset</button>
        </div>
    </div>
</div>

<!-- Communication Timeline -->
<div class="form-container">
    <h4 class="mb-3">📜 Communication Timeline</h4>
    <div class="timeline">
        @if (Model.Communications.Any())
        {
            @foreach (var comm in Model.Communications)
            {
                <div class="comm-card">
                    <div class="row">
                        <div class="col-md-8">
                            <h5>@comm.CustomerName</h5>
                            <span class="comm-type comm-type-@comm.CommTypeClass">
                                @comm.CommTypeIcon @comm.CommType
                            </span>
                            <div class="mt-2"><strong>Notes:</strong> @comm.Notes</div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="comm-date">📅 @comm.CommunicationDate.ToString("MMMM dd, yyyy")</div>
                            <div class="comm-date">🕐 @comm.CommunicationDate.ToString("h:mm tt")</div>
                            <div class="mt-2">
                                <form method="post" asp-page-handler="Delete" style="display:inline">
                                    <input type="hidden" name="id" value="@comm.LogID" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this communication record?')">🗑️ Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center">No communication records found.</p>
        }
    </div>
</div>

<script>
    function insertNote(note) {
        var notesField = document.getElementById('commNotes');
        notesField.value += note + "\n\n";
    }
    
    function applyFilters() {
        var search = document.getElementById('searchCustomer').value;
        var type = document.getElementById('filterType').value;
        window.location.href = '/Communication?search=' + encodeURIComponent(search) + '&type=' + type;
    }
    
    function resetFilters() {
        window.location.href = '/Communication';
    }
</script>