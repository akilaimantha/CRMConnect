@page
@model CRMConnect.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Welcome";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Relationship Management System - Sri Lanka Insurance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/slic-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="login-hero">
        <div class="container position-relative" style="z-index: 2;">
            <div class="text-center text-white mb-5">
                <img src="~/images/slic-logo.svg" alt="SLIC" width="90" class="mb-3 rounded-3 shadow" />
                <h1 class="display-6 fw-bold">Customer Relationship Management System</h1>
                <p class="lead opacity-90 mb-0">Sri Lanka Insurance Corporation</p>
                <p class="small opacity-75">Sales Organization Portal</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-slic text-center mx-auto mb-4" style="max-width: 500px;">
                    @Model.ErrorMessage
                </div>
            }

            <div class="row g-4 justify-content-center" style="max-width: 900px; margin: 0 auto;">
                <!-- Admin Portal -->
                <div class="col-md-6">
                    <div class="portal-card admin h-100">
                        <div class="portal-icon">⚙️</div>
                        <h3 class="text-slic-teal" style="color: var(--slic-teal);">Admin Portal</h3>
                        <p class="text-muted">Manage customers, sales, tasks, communications, users and system settings.</p>
                        <form method="post" asp-page-handler="AdminLogin">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Username</label>
                                <input type="text" name="username" class="form-control" placeholder="admin" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Password</label>
                                <input type="password" name="password" class="form-control" placeholder="admin123" required />
                            </div>
                            <button type="submit" class="btn-slic-gold w-100 justify-content-center">
                                Admin Login <span class="btn-arrow-icon">→</span>
                            </button>
                        </form>
                        <p class="small text-muted mt-3 mb-0">Demo: admin / admin123</p>
                    </div>
                </div>

                <!-- Customer Portal -->
                <div class="col-md-6">
                    <div class="portal-card customer h-100">
                        <div class="portal-icon">👤</div>
                        <h3 style="color: #b8860b;">Customer Portal</h3>
                        <p class="text-muted">View your profile, policies, communication history and contact support.</p>
                        <form method="post" asp-page-handler="CustomerLogin">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="email" class="form-control" placeholder="contact@abc.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Password</label>
                                <input type="password" name="password" class="form-control" placeholder="customer123" required />
                            </div>
                            <button type="submit" class="btn-slic-dark w-100 justify-content-center">
                                Customer Login <span class="btn-arrow-icon">→</span>
                            </button>
                        </form>
                        <p class="small text-muted mt-3 mb-0">Demo: contact@abc.com / customer123</p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-5">
                <span class="text-white opacity-75 small">Powered by ASP.NET Core & Oracle Database</span>
            </div>
        </div>
    </div>
</body>
</html>
