@page
@model CRMConnect.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Customer Relationship Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/slic-theme.css" asp-append-version="true" />
</head>
<body>
    <div class="login-hero">
        <div class="container position-relative" style="z-index:2; max-width:480px;">
            <div class="text-center text-white mb-4">
                <img src="~/images/slic-logo.svg" alt="SLIC" width="80" class="mb-3 rounded-3 shadow" />
                <h1 class="h4 fw-bold">Customer Relationship Management System</h1>
                <p class="small opacity-75 mb-0">Sri Lanka Insurance Corporation</p>
            </div>
            <div class="portal-card admin">
                <h3 style="color:var(--slic-teal); font-size:1.1rem;" class="mb-3">Sign In</h3>
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-slic py-2 small">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="admin or sales1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn-slic-gold w-100 justify-content-center">
                        Login <span class="btn-arrow-icon">→</span>
                    </button>
                </form>
                <hr class="my-3" />
                <p class="small text-muted mb-1"><strong>Admin:</strong> admin / admin123</p>
                <p class="small text-muted mb-0"><strong>Sales:</strong> sales1 / sales123</p>
            </div>
            <p class="text-center text-white opacity-75 small mt-4">ASP.NET Core · Oracle Database · HTML · CSS · JavaScript</p>
        </div>
    </div>
</body>
</html>
