@page
@model CRMConnect.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <h1 class="mb-4">📊 CRM Dashboard</h1>
    
    <!-- Statistics Cards - HTML + CSS -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary card-stats">
                <div class="card-body">
                    <h5 class="card-title">👥 Total Customers</h5>
                    <h2 class="card-text">@Model.TotalCustomers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger card-stats">
                <div class="card-body">
                    <h5 class="card-title">✅ Pending Tasks</h5>
                    <h2 class="card-text">@Model.PendingTasks</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success card-stats">
                <div class="card-body">
                    <h5 class="card-title">💰 Sales Activities</h5>
                    <h2 class="card-text">@Model.TotalSales</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Tasks Table -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">📋 Recent Tasks (Due Soon)</h4>
        </div>
        <div class="card-body">
            @if (Model.RecentTasks.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Task Description</th>
                            <th>Assigned To</th>
                            <th>Due Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.RecentTasks)
                        {
                            <tr>
                                <td>@task.TaskDescription</td>
                                <td>@task.AssignedTo</td>
                                <td>@task.DueDate?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (task.Status == "Pending")
                                    {
                                        <span class="status-pending">⏳ Pending</span>
                                    }
                                    else
                                    {
                                        <span class="status-completed">✅ Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No tasks found.</p>
            }
        </div>
    </div>
</div>