@page
@model CRMConnect.Pages.Portal.PortalHomeModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="slic-page-title">Welcome, @Model.CustomerName</h2>
        <p class="slic-page-subtitle mb-0">Your Sri Lanka Insurance customer relationship overview</p>
    </div>
    <div class="col-md-4 text-md-end">
        <span class="badge bg-warning text-dark px-3 py-2">@Model.PolicyType</span>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="slic-stat-card">
            <div class="slic-stat-icon">📋</div>
            <div class="slic-stat-number">@Model.MyTasks</div>
            <div class="slic-stat-label">Open Tasks</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="slic-stat-card gold">
            <div class="slic-stat-icon">💬</div>
            <div class="slic-stat-number">@Model.MyCommunications</div>
            <div class="slic-stat-label">Communications</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="slic-stat-card dark">
            <div class="slic-stat-icon">📈</div>
            <div class="slic-stat-number">@Model.MySales</div>
            <div class="slic-stat-label">Sales Updates</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="slic-card">
            <div class="slic-card-header">Recent Messages</div>
            <div class="slic-card-body">
                @if (Model.RecentComms.Any())
                {
                    foreach (var c in Model.RecentComms)
                    {
                        <div class="activity-item mb-2">
                            <span class="comm-type comm-type-@c.TypeClass">@c.CommType</span>
                            <div class="small text-muted mt-1">@c.Date.ToString("dd MMM yyyy")</div>
                            <div class="mt-1">@c.Notes</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No communications yet.</p>
                }
                <a href="/Portal/Communications" class="btn btn-sm btn-slic-teal text-white mt-3">View All</a>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="slic-card">
            <div class="slic-card-header gold">Quick Links</div>
            <div class="slic-card-body d-grid gap-2">
                <a href="/Portal/Profile" class="btn btn-outline-secondary text-start">👤 View My Profile</a>
                <a href="/Portal/Policies" class="btn btn-outline-secondary text-start">📄 My Insurance Policies</a>
                <a href="/Portal/Support" class="btn btn-outline-secondary text-start">🆘 Contact Support</a>
            </div>
        </div>
    </div>
</div>
