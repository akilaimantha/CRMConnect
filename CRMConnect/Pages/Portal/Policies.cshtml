@page
@model CRMConnect.Pages.Portal.PoliciesModel
@{
    ViewData["Title"] = "My Policies";
}

<h2 class="slic-page-title">My Insurance Policies</h2>
<p class="slic-page-subtitle">Your active coverage with Sri Lanka Insurance</p>

<div class="row g-4">
    <div class="col-md-6">
        <div class="slic-card h-100">
            <div class="slic-card-header gold">Primary Policy</div>
            <div class="slic-card-body">
                <h4 style="color: var(--slic-teal);">@Model.PolicyType</h4>
                <p class="text-muted">Policy holder: <strong>@Model.CustomerName</strong></p>
                <ul class="list-unstyled">
                    <li class="mb-2">✓ Life coverage protection</li>
                    <li class="mb-2">✓ Premium payment reminders</li>
                    <li class="mb-2">✓ Dedicated sales representative</li>
                </ul>
                <span class="badge-slic-done">Active</span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="slic-card h-100">
            <div class="slic-card-header">Related Sales Updates</div>
            <div class="slic-card-body">
                @if (Model.SalesUpdates.Any())
                {
                    foreach (var s in Model.SalesUpdates)
                    {
                        <div class="activity-item">
                            <span class="badge-warm">@s.LeadStatus</span>
                            <div class="small text-muted mt-1">@s.ActivityDate.ToString("dd MMM yyyy")</div>
                            <div class="mt-1">@s.Notes</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No sales updates on file.</p>
                }
            </div>
        </div>
    </div>
</div>
