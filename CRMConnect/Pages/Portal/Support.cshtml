@page
@model CRMConnect.Pages.Portal.SupportModel
@{
    ViewData["Title"] = "Support";
}

<h2 class="slic-page-title">Customer Support</h2>
<p class="slic-page-subtitle">We're here to help with your insurance needs</p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="slic-card">
            <div class="slic-card-header">Send a Message</div>
            <div class="slic-card-body">
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-slic">@Model.Message</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Subject</label>
                        <select name="subject" class="form-select">
                            <option>Policy Inquiry</option>
                            <option>Premium Payment</option>
                            <option>Claim Support</option>
                            <option>General Question</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message *</label>
                        <textarea name="body" class="form-control" rows="5" required placeholder="How can we help you?"></textarea>
                    </div>
                    <button type="submit" class="btn-slic-gold w-100 justify-content-center">Submit Request <span class="btn-arrow-icon">→</span></button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="slic-card">
            <div class="slic-card-header gold">Contact Information</div>
            <div class="slic-card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded" style="background: var(--slic-bg);">
                            <strong>📞 Hotline</strong>
                            <div>1312</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded" style="background: var(--slic-bg);">
                            <strong>✉️ Email</strong>
                            <div>support@slic.lk</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 rounded" style="background: var(--slic-bg);">
                            <strong>🏢 Head Office</strong>
                            <div class="text-muted small">Sri Lanka Insurance Corporation, Colombo</div>
                        </div>
                    </div>
                </div>
                <hr />
                <h6 class="fw-bold" style="color: var(--slic-teal);">Business Hours</h6>
                <p class="small text-muted mb-0">Monday – Friday: 8:30 AM – 4:30 PM<br />Saturday: 9:00 AM – 12:00 PM</p>
            </div>
        </div>
    </div>
</div>
