@page
@model CRMConnect.Pages.SalesModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Sales Activities";
}

<h2 class="slic-page-title">Sales Tracking</h2>
<p class="slic-page-subtitle">Track sales activities, leads, and pipeline stages</p>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="slic-stat-card"><div class="slic-stat-number">@Model.TotalLeads</div><div class="slic-stat-label">Total Leads</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card gold"><div class="slic-stat-number">@Model.HotLeads</div><div class="slic-stat-label">Hot Leads</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card"><div class="slic-stat-number">@Model.ConversionRate%</div><div class="slic-stat-label">Conversion Rate</div></div></div>
    <div class="col-md-3"><div class="slic-stat-card dark"><div class="slic-stat-number">$@Model.EstimatedRevenue</div><div class="slic-stat-label">Est. Revenue</div></div></div>
</div>

<div class="slic-card mb-4">
    <div class="slic-card-header">Sales Pipeline</div>
    <div class="slic-card-body">
        <div class="row g-3">
            <div class="col-md-3"><div class="pipeline-stage"><div class="pipeline-count">@Model.LeadCount</div><div>Lead</div></div></div>
            <div class="col-md-3"><div class="pipeline-stage"><div class="pipeline-count">@Model.QualifiedCount</div><div>Qualified</div></div></div>
            <div class="col-md-3"><div class="pipeline-stage"><div class="pipeline-count">@Model.ProposalCount</div><div>Proposal</div></div></div>
            <div class="col-md-3"><div class="pipeline-stage"><div class="pipeline-count">@Model.ClosedCount</div><div>Closed</div></div></div>
        </div>
    </div>
</div>

<div class="slic-card mb-4">
    <div class="slic-card-header gold">Log New Sales Activity</div>
    <div class="slic-card-body">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-slic alert-dismissible fade show">@Model.Message<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Customer *</label>
                    <select name="CustomerId" class="form-select" required>
                        <option value="">-- Select --</option>
                        @foreach (var c in Model.Customers) { <option value="@c.CustomerID">@c.Name</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Lead Status</label>
                    <select name="LeadStatus" class="form-select">
                        <option>Hot Lead</option>
                        <option>Warm Lead</option>
                        <option>Cold Lead</option>
                        <option>Negotiation</option>
                        <option>Proposal Sent</option>
                        <option>Closed Won</option>
                        <option>Closed Lost</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn-slic-gold">Log Activity <span class="btn-arrow-icon">→</span></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="slic-card mb-3">
    <div class="slic-card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Filter Status</label>
                <select id="filterStatus" class="form-select form-select-sm" onchange="applyFilter()">
                    <option value="All">All</option>
                    <option value="Hot Lead">Hot Leads</option>
                    <option value="Warm Lead">Warm Leads</option>
                    <option value="Closed Won">Closed Won</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small">Sort</label>
                <select id="sortOrder" class="form-select form-select-sm" onchange="applyFilter()">
                    <option value="DESC">Newest First</option>
                    <option value="ASC">Oldest First</option>
                </select>
            </div>
            <div class="col-md-4"><button class="btn btn-sm btn-outline-secondary w-100" onclick="location.href='/Sales'">Reset</button></div>
        </div>
    </div>
</div>

<div class="slic-card">
    <div class="slic-card-header">Recent Sales Activities</div>
    <div class="slic-card-body">
        @if (Model.SalesActivities.Any())
        {
            @foreach (var activity in Model.SalesActivities)
            {
                <div class="activity-item">
                    <div class="d-flex justify-content-between flex-wrap">
                        <div>
                            <h5 class="mb-1" style="color: var(--slic-teal);">@activity.CustomerName</h5>
                            <span class="text-muted small">@activity.ActivityDate.ToString("dd MMM yyyy · h:mm tt")</span>
                            @{
                                var badge = activity.LeadStatus.Contains("Hot") || activity.LeadStatus.Contains("Won") ? "hot" :
                                    activity.LeadStatus.Contains("Warm") ? "warm" : "cold";
                            }
                            <span class="badge-@badge ms-2">@activity.LeadStatus</span>
                            <p class="mt-2 mb-0">@activity.Notes</p>
                        </div>
                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="id" value="@activity.ActivityID" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete?')">Delete</button>
                        </form>
                    </div>
                </div>
            }
        }
        else { <p class="text-muted text-center">No sales activities found.</p> }
    </div>
</div>

@section Scripts {
<script>
    function applyFilter() {
        window.location.href = '/Sales?filter=' + document.getElementById('filterStatus').value + '&sort=' + document.getElementById('sortOrder').value;
    }
</script>
}
