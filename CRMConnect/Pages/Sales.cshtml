@page
@model CRMConnect.Pages.SalesModel
@{
    ViewData["Title"] = "Sales Activities";
}

<style>
    .sales-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
    }
    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }
    .stat-card:hover {
        transform: translateY(-5px);
    }
    .stat-number {
        font-size: 32px;
        font-weight: bold;
        color: #667eea;
    }
    .stat-label {
        color: #666;
        margin-top: 10px;
    }
    .lead-hot {
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-block;
    }
    .lead-warm {
        background: #ffc107;
        color: #333;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-block;
    }
    .lead-cold {
        background: #6c757d;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        display: inline-block;
    }
    .form-container {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        transition: transform 0.3s;
    }
    .btn-gradient:hover {
        transform: scale(1.05);
        color: white;
    }
    .activity-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 15px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        border-left: 4px solid #667eea;
        transition: all 0.3s;
    }
    .activity-card:hover {
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        transform: translateX(5px);
    }
    .activity-date {
        color: #667eea;
        font-weight: bold;
        font-size: 14px;
    }
    .filter-bar {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
    }
    .pipeline-stage {
        text-align: center;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
        margin: 5px;
    }
    .pipeline-count {
        font-size: 24px;
        font-weight: bold;
        color: #667eea;
    }
</style>

<div class="sales-header">
    <div class="row">
        <div class="col-md-8">
            <h1>📊 Sales Activities</h1>
            <p class="mb-0">Track and manage your sales pipeline, leads, and customer interactions</p>
        </div>
        <div class="col-md-4 text-end">
            <span class="lead-hot me-2">Hot Leads</span>
            <span class="lead-warm me-2">Warm Leads</span>
            <span class="lead-cold">Cold Leads</span>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-number" id="totalLeads">@Model.TotalLeads</div>
            <div class="stat-label">Total Leads</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-number" id="hotLeads">@Model.HotLeads</div>
            <div class="stat-label">Hot Leads</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-number" id="conversionRate">@Model.ConversionRate%</div>
            <div class="stat-label">Conversion Rate</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-number" id="revenue">$@Model.EstimatedRevenue</div>
            <div class="stat-label">Estimated Revenue</div>
        </div>
    </div>
</div>

<!-- Sales Pipeline -->
<div class="form-container">
    <h4 class="mb-3">📊 Sales Pipeline</h4>
    <div class="row">
        <div class="col-md-3">
            <div class="pipeline-stage">
                <div class="pipeline-count">@Model.LeadCount</div>
                <div>Lead</div>
                <small class="text-muted">Initial Contact</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pipeline-stage">
                <div class="pipeline-count">@Model.QualifiedCount</div>
                <div>Qualified</div>
                <small class="text-muted">Needs Analysis</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pipeline-stage">
                <div class="pipeline-count">@Model.ProposalCount</div>
                <div>Proposal</div>
                <small class="text-muted">Quote Sent</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="pipeline-stage">
                <div class="pipeline-count">@Model.ClosedCount</div>
                <div>Closed</div>
                <small class="text-muted">Won/Lost</small>
            </div>
        </div>
    </div>
</div>

<!-- Add Sales Activity Form -->
<div class="form-container">
    <h4 class="mb-3">➕ Log New Sales Activity</h4>
    
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-@(Model.IsSuccess ? "success" : "danger") alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <form method="post">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Select Customer *</label>
                <select name="CustomerId" class="form-select" required>
                    <option value="">-- Select Customer --</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.CustomerID">@customer.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Lead Status *</label>
                <select name="LeadStatus" class="form-select">
                    <option value="Hot Lead">🔥 Hot Lead - Ready to buy</option>
                    <option value="Warm Lead">💛 Warm Lead - Interested</option>
                    <option value="Cold Lead">❄️ Cold Lead - Initial contact</option>
                    <option value="Negotiation">🤝 Negotiation - Discussing terms</option>
                    <option value="Proposal Sent">📄 Proposal Sent - Awaiting response</option>
                    <option value="Closed Won">🏆 Closed Won - Deal secured</option>
                    <option value="Closed Lost">❌ Closed Lost - Deal lost</option>
                </select>
            </div>
            <div class="col-md-12 mb-3">
                <label class="form-label">Activity Notes</label>
                <textarea name="Notes" class="form-control" rows="3" placeholder="Describe the sales activity, customer response, next steps..."></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn-gradient">📝 Log Sales Activity</button>
            </div>
        </div>
    </form>
</div>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="row">
        <div class="col-md-4">
            <label>Filter by Status</label>
            <select id="filterStatus" class="form-select" onchange="applyFilter()">
                <option value="All">All Activities</option>
                <option value="Hot Lead">Hot Leads</option>
                <option value="Warm Lead">Warm Leads</option>
                <option value="Negotiation">Negotiation</option>
                <option value="Closed Won">Closed Won</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Sort by Date</label>
            <select id="sortOrder" class="form-select" onchange="applyFilter()">
                <option value="DESC">Newest First</option>
                <option value="ASC">Oldest First</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>&nbsp;</label>
            <button class="btn btn-secondary w-100" onclick="resetFilters()">Reset Filters</button>
        </div>
    </div>
</div>

<!-- Sales Activities List -->
<div class="form-container">
    <h4 class="mb-3">📋 Recent Sales Activities</h4>
    <div id="activitiesList">
        @if (Model.SalesActivities.Any())
        {
            @foreach (var activity in Model.SalesActivities)
            {
                <div class="activity-card">
                    <div class="row">
                        <div class="col-md-8">
                            <h5>@activity.CustomerName</h5>
                            <div class="activity-date">📅 @activity.ActivityDate.ToString("MMMM dd, yyyy - h:mm tt")</div>
                            <div class="mt-2">
                                <strong>Status:</strong>
                                @if (activity.LeadStatus.Contains("Hot") || activity.LeadStatus.Contains("Won"))
                                {
                                    <span class="lead-hot ms-2">@activity.LeadStatus</span>
                                }
                                else if (activity.LeadStatus.Contains("Warm"))
                                {
                                    <span class="lead-warm ms-2">@activity.LeadStatus</span>
                                }
                                else
                                {
                                    <span class="lead-cold ms-2">@activity.LeadStatus</span>
                                }
                            </div>
                            <div class="mt-2"><strong>Notes:</strong> @activity.Notes</div>
                        </div>
                        <div class="col-md-4 text-end">
                            <form method="post" asp-page-handler="Delete" style="display:inline">
                                <input type="hidden" name="id" value="@activity.ActivityID" />
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this activity?')">🗑️ Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center">No sales activities found.</p>
        }
    </div>
</div>

<script>
    function applyFilter() {
        var status = document.getElementById('filterStatus').value;
        var sort = document.getElementById('sortOrder').value;
        window.location.href = '/Sales?filter=' + status + '&sort=' + sort;
    }
    
    function resetFilters() {
        window.location.href = '/Sales';
    }
</script>