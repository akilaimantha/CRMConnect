<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRMConnect</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Custom CSS -->
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f5f7fa;
        }
        .navbar-custom {
            background: #2c3e50 !important;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: white !important;
        }
        .navbar-custom .nav-link:hover {
            background: #34495e;
            border-radius: 5px;
        }
        .card-stats {
            transition: transform 0.3s;
        }
        .card-stats:hover {
            transform: translateY(-5px);
        }
        .footer {
            background: #2c3e50;
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 30px;
        }
        .container-main {
            min-height: 500px;
            padding: 20px;
        }
        .status-pending {
            color: #e74c3c;
            font-weight: bold;
        }
        .status-completed {
            color: #27ae60;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">🏢 CRMConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">📊 Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Customers">👥 Customers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Sales">💰 Sales</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Tasks">✅ Tasks</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Communication">📞 Communication</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin">⚙️ Admin</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <div class="footer">
        &copy; @DateTime.Now.Year CRMConnect - Customer Relationship Management System
        <br />
        <small>Powered by ASP.NET Core | Oracle Database</small>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JavaScript for Notifications -->
    <script>
        // Function to check for due tasks via AJAX
        function checkDueTasks() {
            $.ajax({
                url: '/api/notifications',
                type: 'GET',
                success: function(data) {
                    if (data > 0) {
                        alert('⚠️ You have ' + data + ' task(s) due in the next 3 days!');
                    }
                },
                error: function() {
                    console.log('Notification check failed');
                }
            });
        }
        
        // Check for due tasks when page loads
        $(document).ready(function() {
            checkDueTasks();
            // Check every 5 minutes
            setInterval(checkDueTasks, 300000);
        });
        
        // Client-side form validation helper
        function validateRequired(fieldId, message) {
            var value = document.getElementById(fieldId)?.value;
            if (!value || value.trim() === '') {
                alert(message);
                return false;
            }
            return true;
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>