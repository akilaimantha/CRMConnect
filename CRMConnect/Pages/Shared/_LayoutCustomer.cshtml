<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SLIC Customer Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/slic-theme.css" asp-append-version="true" />
</head>
<body class="slic-body d-flex flex-column" data-portal="customer">
    <header class="slic-header">
        <div class="slic-header-pattern"></div>
        <nav class="navbar navbar-expand-lg slic-navbar">
            <div class="container">
                <a class="slic-brand" href="/Portal">
                    <img src="~/images/slic-logo.svg" alt="SLIC" />
                    <div class="slic-brand-text">
                        <h1>Customer Portal</h1>
                        <span>Sri Lanka Insurance · LIFE</span>
                    </div>
                </a>
                <button class="navbar-toggler navbar-dark border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="portalNav">
                    <ul class="navbar-nav slic-nav-links ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="/Portal">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Portal/Profile">My Profile</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Portal/Communications">Messages</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Portal/Policies">My Policies</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Portal/Support">Support</a></li>
                        <li class="nav-item ms-lg-2">
                            <span class="user-badge me-2">@(Context.Session.GetString("DisplayName") ?? "Customer")</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn-slic-dark btn-sm" href="/Logout">Logout <span class="btn-arrow-icon">→</span></a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="slic-main flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="slic-footer">
        <div>&copy; @DateTime.Now.Year Sri Lanka Insurance Corporation — Customer Portal</div>
        <small>Need help? Contact support@slic.lk</small>
    </footer>

    <script src="https://code.jquery.com/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/crm.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
